# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Supabase (required for auth, database, storage)
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key-here

# Site URL for OAuth redirects (e.g. https://getglory.pk)
REACT_APP_SITE_URL=https://your-domain.com

# Passport AI URL (optional). Leave unset / local to use free browser crop on the site.
# Hugging Face Gradio/Docker Spaces may require PRO — prefer browser crop, or Render free later.
# REACT_APP_PASSPORT_AI_URL=https://passport-ai-xxxx.onrender.com
REACT_APP_PASSPORT_AI_URL=http://127.0.0.1:8001
